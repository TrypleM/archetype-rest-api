{
    "name": "Archetype-API-REST",
    "version": "1.0.0",
    "description": "API rest de ejemplo",
    "license": "ISC",
    "author": "",
    "type": "module",
    "engines": {
        "node": ">=22.14"
    },
    "main": "src/main.ts",
    "scripts": {
        "start": "node --experimental-strip-types src/main.ts",
        "dev": "node --experimental-strip-types --watch src/main.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --experimental-strip-types --test tests/*.test.ts",
        "test:coverage": "node --experimental-strip-types --experimental-test-coverage --test tests/*.test.ts",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "dependencies": {
        "express": "^5.3.0",
        "helmet": "^8.3.0"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.5",
        "prettier": "3.9.10",
        "typescript": "^7.0.2"
    }
}
